#!/usr/bin/env bash
# OpenShift DPF Required Environment Variables
# -----------------------------------------------
# Source this file to validate that critical variables are set before
# generating the .env file. These have no defaults — they must be
# provided per-environment.
# Syntax: ${VAR:?message} fails immediately if VAR is unset or empty.

# Cluster
: ${CLUSTER_NAME:?CLUSTER_NAME must be set}
: ${BASE_DOMAIN:?BASE_DOMAIN must be set}

# Network / DPU
if [ "${VM_COUNT:-3}" -gt 1 ]; then
    : ${API_VIP:?API_VIP must be set (required for multi-node clusters)}
    : ${INGRESS_VIP:?INGRESS_VIP must be set (required for multi-node clusters)}
fi
if [ "${VM_STATIC_IP:-false}" = "true" ]; then
    : ${VM_EXT_IPS:?VM_EXT_IPS must be set when VM_STATIC_IP=true}
    : ${VM_EXT_PL:?VM_EXT_PL must be set when VM_STATIC_IP=true}
    : ${VM_GW:?VM_GW must be set when VM_STATIC_IP=true}
    : ${VM_DNS:?VM_DNS must be set when VM_STATIC_IP=true}
fi
: ${DPU_HOST_CIDR:?DPU_HOST_CIDR must be set (e.g. 10.0.110.0/24)}

# BFB
: ${BFB_URL:?BFB_URL must be set}

# Zero Trust DPU discovery
if [ "${DPF_DEPLOYMENT_MODE:-host-trusted}" = "zero-trust" ]; then
    : ${ZT_DPU_BMC_IP_RANGE_START:?ZT_DPU_BMC_IP_RANGE_START must be set for Zero Trust}
    : ${ZT_DPU_BMC_IP_RANGE_END:?ZT_DPU_BMC_IP_RANGE_END must be set for Zero Trust}
    : ${ZT_BMC_ROOT_PASSWORD:?ZT_BMC_ROOT_PASSWORD must be set for Zero Trust}
    : ${DPU1_SERIAL:?DPU1_SERIAL must be set for Zero Trust}
fi
